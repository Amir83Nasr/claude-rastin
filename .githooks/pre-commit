#!/bin/sh
# Format staged files with Prettier. lint-staged re-stages only what was
# staged, so unstaged hunks of the same file stay out of the commit.
set -e

cd "$(git rev-parse --show-toplevel)"

[ -x node_modules/.bin/lint-staged ] || {
  echo "pre-commit: run 'pnpm install' first" >&2
  exit 1
}

exec node_modules/.bin/lint-staged
